# Copie para .env e ajuste. O arquivo .env NÃO vai para o Git.
POSTGRES_USER=investwallet
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=investwallet
POSTGRES_PORT=5432

# Lido pelo ASP.NET Core: "__" equivale a ":" na hierarquia do appsettings.json
ConnectionStrings__Default="Host=localhost;Port=5432;Database=investwallet;Username=investwallet;Password=troque-esta-senha"

# Porta publicada da API no docker compose
API_PORT=8080

# Sentry (opcional). Deixe vazio para desativar. O DSN é o endereço do seu projeto no Sentry
# (Project Settings > Client Keys). Não o versione: ele pertence ao seu .env, que é ignorado pelo Git.
SENTRY_DSN=
